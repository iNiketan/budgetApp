# Copy to .env and fill in your values:  cp .env.example .env && chmod 600 .env
#
# WARNING: Expo inlines every EXPO_PUBLIC_* value into the JS bundle at build
# time. Anyone holding the built APK can read these back out as plain text, so
# treat the APK itself as containing secrets. See SECURITY.md.

# Google Apps Script deployment URL (must be https://)
EXPO_PUBLIC_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Shared secret the Apps Script backend checks on every request.
# Rotate it in the Apps Script editor AND update the deployment to a new
# version — a plain Save does not take effect.
EXPO_PUBLIC_PASSWORD=your-api-password

# 4-digit app unlock PIN. Convenience lock only, not data protection.
EXPO_PUBLIC_PIN=0000
