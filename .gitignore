# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/

# ==============================================================================
# SENSITIVE DATA & CREDENTIALS (NEVER COMMIT)
# ==============================================================================
# Environment variables — .env holds the sheet password and app PIN
.env
.env.*
*.env
!.env.example
!.env.sample

# Keystores, signing keys & private certificates
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.der
AuthKey_*.p8

# Cloud, API & service credentials
credentials.json
eas-credentials.json
client_secret*.json
service-account*.json
serviceAccount*.json
*secret*.json
secrets/
private/
*.secret

# Firebase / Google Services configuration
google-services.json
GoogleService-Info.plist

# Fastlane credentials & exports
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
AppStoreExportOptions.plist

# ==============================================================================
# BUILD ARTIFACTS & LOGS
# ==============================================================================
*.apk
*.aab
*.ipa
*.zip
*.tar.gz
build-*
coverage/
.jest-cache/

# Logs & dumps
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.hprof

# Native projects — generated by `expo prebuild` (Continuous Native Generation).
# EAS Build regenerates these on the cloud, so they are not source.
/android
/ios

# ==============================================================================
# IDE & OS ARTIFACTS
# ==============================================================================
.claude/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
